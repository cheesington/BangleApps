  "provides_modules": ["sailracerlib"],
  "icon": "app-icon.png",
  "storage": [
    { "name": "sailracer.app.js", "url": "app.js" },
    { "name": "sailracer.wid.js", "url": "widget.js" },
    { "name": "sailracer.img", "url":"app-icon.js", "evaluate":true },
    { "name": "sailracerlib", "url": "lib.js" }
  ]
}
