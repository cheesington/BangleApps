{
  "id": "sailracer",
  "version": "0.02",
  "name": "Sail Race Timer",
  "shortName": "Race Timer",
  "author": "colinf",
  "description": "Timer for sailboat race starting sequences",
  "tags": "tool,outdoors",
  "supports": ["BANGLEJS", "BANGLEJS2"],
  "allow_emulator": true,
  "data": ["sailracer.json", "sailracer.timer.json"],
  "provides_modules": ["sailracerlib"],
  "icon": "app-icon.png",
  "storage": [
    { "name": "sailracer.app.js", "url": "app.js" },
    { "name": "sailracer.wid.js", "url": "widget.js" },
    { "name": "sailracer.img", "url":"app-icon.js", "evaluate":true },
    { "name": "sailracerlib", "url": "lib.js" }
  ]
}
